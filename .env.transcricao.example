# Configurações da integração com o serviço de transcrição.
# Copie este arquivo para .env.transcricao e preencha os valores reais.

TRANSCRIPTION_REQUEST_URL=""
TRANSCRIPTION_STATUS_URL=""
TRANSCRIPTION_API_KEY=""
TRANSCRIPTION_REQUEST_TIMEOUT_SECONDS=60
TRANSCRIPTION_POLL_INTERVAL_SECONDS=5
TRANSCRIPTION_TIMEOUT_SECONDS=480

# Relay temporário para mídias que a API de transcrição não acessa diretamente
TRANSCRIPTION_MEDIA_RELAY_ENABLED=false
TRANSCRIPTION_MEDIA_RELAY_ALLOWED_HOSTS="nat-bot.mpac.mp.br"
GCS_BUCKET_NAME=""
GCS_OBJECT_PREFIX="transcription-media"
GCS_SIGNED_URL_TTL_SECONDS=900
GCS_MEDIA_MAX_SIZE_MIB=250
GCS_SERVICE_ACCOUNT_FILE="/run/secrets/gcs-service-account.json"
GOOGLE_CLOUD_PROJECT=""
